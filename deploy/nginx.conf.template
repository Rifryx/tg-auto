# nginx для Mini App: статика + прокси /api/* на api-сервис (один origin).
#
# ОТЛИЧИЕ ОТ ВЕРСИИ ДЛЯ DOCKER COMPOSE: resolver и upstream адрес api теперь
# подставляются из ENV при старте контейнера (см. docker-entrypoint-frontend.sh),
# а не захардкожены — в Railway нет Docker embedded DNS (127.0.0.11) и нет
# постоянного hostname "api" как в compose-сети.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Резолвер приватной сети окружения (Railway/Docker/иное) — подставляется
    # entrypoint-скриптом из /etc/resolv.conf контейнера. Нужен, чтобы nginx
    # не кэшировал IP api навсегда: при пересоздании api-сервиса на Railway он
    # получает новый внутренний адрес, и без переменной в proxy_pass nginx
    # продолжал бы стучаться в старый ("502 Bad Gateway").
    resolver ${RESOLVER_IP} valid=10s;

    # API через тот же origin → нет CORS, initData-заголовки доходят как есть.
    # API_UPSTREAM — host:port api-сервиса, например api.railway.internal:8000
    # (Railway private networking); задаётся переменной окружения API_UPSTREAM.
    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$api_upstream:8000;
        proxy_http_version 1.1;
        client_max_body_size 25m;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    # Railway health check / быстрый пинг самого фронта.
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # SPA: любой маршрут отдаёт index.html (React Router).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
