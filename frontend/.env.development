# Dev-режим Mini App: фейковый пользователь и адрес backend.
# .env.local в frontend/ переопределяет это (например, VITE_API_BASE=""
# для single-origin через Vite proxy при ngrok-туннелировании).
VITE_DEV_USER_ID=1
VITE_API_BASE=http://localhost:8000
# Разрешить любые Host-заголовки (нужно для ngrok, DNS rebinding guard
# блокирует публичные домены по умолчанию). Для продакшена оставить пустым.
VITE_ALLOWED_HOST=all
