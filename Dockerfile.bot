# Bot-образ: Telegram-бот (bot.main).
#
# Один процесс: aiogram polling + notifier (Redis pub/sub → чат админа).
# Никаких миграций (их делает api-контейнер). БД читается напрямую (только read).
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml ./
COPY core ./core
COPY api ./api
COPY worker ./worker
COPY modules ./modules
COPY bot ./bot

RUN pip install .

CMD ["python", "-m", "bot.main"]
