# Скопируй в .env (`cp .env.example .env`) и заполни секреты.
# Значения ниже — dev-заглушки: с DEV_MODE=true стек поднимается «из коробки».
# Для прода: DEV_MODE=false + реальные Telegram/LLM-ключи + свой ENCRYPTION_KEY.

# --- Postgres (из них compose собирает DATABASE_URL для api/worker) ---
POSTGRES_USER=neuro
POSTGRES_PASSWORD=neuro
POSTGRES_DB=neuro

# DATABASE_URL / REDIS_URL внутри compose задаются автоматически
# (postgres:5432, redis:6379). Переопределяй только при запуске вне compose:
# DATABASE_URL=postgresql+psycopg://neuro:neuro@localhost:5434/neuro
# REDIS_URL=redis://localhost:6379/0

# --- Критичный секрет (обязателен всегда) ---
# Сгенерируй свой: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=akVtS_hZ4VXgmfpRtpOgcAzGiWE7jdSHQfE5trf1Vsc=

# --- Режим ---
# true — ослабляет требования (dev-заглушки Telegram/LLM, CORS '*'). В проде: false.
DEV_MODE=true

# --- Telegram API (обязательны вне DEV_MODE; в DEV_MODE оставь закомментированными) ---
# ВАЖНО: TELEGRAM_API_ID — целое; пустое значение (TELEGRAM_API_ID=) сломает
# парсинг, поэтому в dev держи строку закомментированной, а не пустой.
# Получить: https://my.telegram.org → API development tools
# TELEGRAM_API_ID=1234567
# TELEGRAM_API_HASH=your_api_hash

# --- Telegram Bot (Mini App auth + чат-бот) ---
# Без этого фронт получит «Auth is not configured (TELEGRAM_BOT_TOKEN unset)»
# на /billing/plan, /admin/me и т.п. Токен создаётся в @BotFather:
#   /newbot → имя → username → BotFather пришлёт токен вида 1234567:ABC...
# В DEV_MODE токен можно оставить пустым (валидация initData отключена),
# но для реального входа через Telegram Mini App — обязателен.
TELEGRAM_BOT_TOKEN=

# --- Админы Mini App (через запятую, Telegram user_id цифрами) ---
# Твой id посмотри у @userinfobot — он не секретен, но ADMIN_USER_IDS хранится
# ТОЛЬКО в ENV, не в БД (чтобы SQL-инъекция не давала админ-права).
# ADMIN_USER_IDS=123456789,987654321
ADMIN_USER_IDS=

# --- Crypto Bot (оплата подписки криптой через @CryptoBot) ---
# Токен приложения: @CryptoBot → Crypto Pay → Create App → API Token.
# Для теста: @CryptoTestnetBot + CRYPTOBOT_NETWORK=testnet.
# В DEV_MODE можно оставить пустым — крипто-оплата работает в stub-режиме
# (инвойс сразу «оплачивается» при проверке, удобно для локального потока).
CRYPTOBOT_API_TOKEN=
# mainnet | testnet
CRYPTOBOT_NETWORK=mainnet
# Актив инвойса (цена в USDT трактуется в этом активе): USDT/TON/BTC/…
CRYPTOBOT_ASSET=USDT

# --- LLM (хотя бы один вне DEV_MODE) ---
# DeepSeek: https://platform.deepseek.com/api_keys
# Gemini:   https://aistudio.google.com/apikey
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# --- CORS origin Mini App (нужен вне DEV_MODE; несколько — через запятую) ---
# В compose-развёртке фронт и API на одном origin через nginx, CORS не нужен.
# Dev-фронт на Vite: http://localhost:5173
# WEBAPP_ORIGIN=http://localhost:5173
WEBAPP_ORIGIN=
