# Frontend-образ: сборка Vite → раздача через nginx с прокси /api → api-сервис
# (Mini App и API на одном origin, чтобы initData-заголовки не спотыкались о CORS).
# Контекст сборки — корень репозитория (нужен и frontend/, и deploy/).
#
# Изменено для деплоя на Railway (вместо фиксированного docker-compose DNS):
# resolver и адрес api-сервиса теперь подставляются из ENV при старте
# контейнера через docker-entrypoint-frontend.sh — см. deploy/nginx.conf.template.

# --- build ---
FROM node:20-slim AS build
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
# Запросы идут на /api → nginx проксирует на api-сервис (см. deploy/nginx.conf.template).
ENV VITE_API_BASE=/api
RUN npm run build

# --- serve ---
FROM nginx:alpine
RUN apk add --no-cache gettext
COPY deploy/nginx.conf.template /etc/nginx/conf.d/default.conf.template
COPY deploy/docker-entrypoint-frontend.sh /docker-entrypoint-frontend.sh
RUN chmod +x /docker-entrypoint-frontend.sh
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
ENTRYPOINT ["/docker-entrypoint-frontend.sh"]
CMD ["nginx", "-g", "daemon off;"]
