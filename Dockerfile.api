# API-образ: gunicorn+uvicorn поверх api.asgi:app (промпт 21), миграции при
# старте через deploy/entrypoint-api.sh (промпт 24).
#
# Ставим ТОЛЬКО прод-зависимости (pyproject [project.dependencies], без группы
# dev). Пакеты монорепо (core/api/worker/modules) ставятся `pip install .`:
# api.asgi импортирует worker.tasks.logging, поэтому worker-пакет тоже нужен.
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Метаданные + исходники, нужные для сборки wheel и рантайма.
COPY pyproject.toml alembic.ini ./
COPY core ./core
COPY api ./api
COPY worker ./worker
COPY modules ./modules
COPY migrations ./migrations
COPY deploy ./deploy

# Прод-зависимости (dev-группа не ставится — она в [optional-dependencies].dev).
RUN pip install .

RUN chmod +x deploy/entrypoint-api.sh

EXPOSE 8000

# alembic upgrade head && exec gunicorn -c deploy/gunicorn.conf.py api.asgi:app
ENTRYPOINT ["deploy/entrypoint-api.sh"]
